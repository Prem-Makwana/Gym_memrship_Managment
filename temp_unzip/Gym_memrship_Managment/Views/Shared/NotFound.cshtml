@{
    ViewData["Title"] = "Not Found";
}

<div class="container text-center py-5">
    <div class="glass-panel p-5 d-inline-block">
        <h1 class="display-1 fw-bold text-neon-blue">404</h1>
        <h2 class="mb-4">Page Not Found</h2>
        <p class="text-muted mb-4">The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p>
        <a href="/" class="btn btn-gradient-primary rounded-pill px-4 py-2">
            <i class="bi bi-house-door me-2"></i>Return to Dashboard
        </a>
    </div>
</div>
