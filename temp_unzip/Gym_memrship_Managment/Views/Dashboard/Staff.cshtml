@model StaffDashboardVm
@{
  ViewData["Title"] = "Staff Dashboard";
  Layout = "_Layout";
}

<div class="page-header animate-fade-in-up">
  <div>
    <h1 class="page-title gradient-text-blue">Staff Dashboard</h1>
    <p class="page-subtitle text-gym-gray">@DateTime.Now.ToString("dddd, MMMM dd yyyy")</p>
  </div>
  <a href="/Attendance/CheckIn" class="btn-gradient-blue"><i class="bi bi-qr-code-scan text-lg"></i> Quick Check-In</a>
</div>

<!-- KPIs -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="stat-card blue">
    <div class="stat-icon"><i class="bi bi-qr-code-scan"></i></div>
    <div class="stat-value anime-count-up" data-value="@Model.TodayCheckIns">0</div>
    <div class="stat-label">Today's Check-Ins</div>
  </div>
  <div class="stat-card green">
    <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
    <div class="stat-value anime-count-up" data-value="@Model.TodayCollection" data-prefix="$" data-decimals="2">0</div>
    <div class="stat-label">Today's Collection</div>
  </div>
  <div class="stat-card gold">
    <div class="stat-icon"><i class="bi bi-clock-history"></i></div>
    <div class="stat-value anime-count-up" data-value="@Model.ExpiringThisWeek">0</div>
    <div class="stat-label">Expiring This Week</div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Expiring Memberships -->
  <div class="glass-card">
    <h3 class="text-xl font-oswald font-bold text-[#FFB347] tracking-wide mb-6 flex items-center gap-3">
      <div class="w-8 h-8 rounded bg-[#FFB347]/20 flex items-center justify-center"><i class="bi bi-clock-history"></i></div> 
      Expiring Memberships
    </h3>
    @if (!Model.ExpiringMemberships.Any())
    {
      <p class="text-center text-gym-gray py-8">No memberships expiring this week</p>
    }
    else
    {
      <div class="space-y-4">
      @foreach (var m in Model.ExpiringMemberships.Take(10))
      {
        <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 hover:border-[#FFB347]/30 transition-colors">
          <div class="flex items-center gap-4">
            <div class="avatar w-10 h-10 text-sm">@m.Member?.FullName?.Substring(0,1)</div>
            <div>
              <div class="font-semibold text-white">@m.Member?.FullName</div>
              <div class="text-xs text-gym-gray tracking-wide">@m.Plan?.PlanName</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-sm font-bold text-[#FFB347] mb-1">@m.DaysRemaining days left</div>
            <a href="/Member/Details/@m.MemberId" class="text-xs font-semibold uppercase text-gym-blue hover:text-white transition-colors">Renew <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      }
      </div>
    }
  </div>

  <!-- Today's Check-Ins -->
  <div class="glass-card">
    <h3 class="text-xl font-oswald font-bold text-gym-blue tracking-wide mb-6 flex items-center gap-3">
      <div class="w-8 h-8 rounded bg-gym-blue/20 flex items-center justify-center"><i class="bi bi-qr-code-scan"></i></div> 
      Today's Activity
    </h3>
    @if (!Model.TodayAttendance.Any())
    {
      <p class="text-center text-gym-gray py-8">No check-ins today yet</p>
    }
    else
    {
      <div class="space-y-4">
      @foreach (var a in Model.TodayAttendance.Take(10))
      {
        <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/5 hover:border-gym-blue/30 transition-colors">
          <div class="flex items-center gap-4">
            <div class="avatar w-10 h-10 text-sm">@a.Member?.FullName?.Substring(0,1)</div>
            <span class="font-semibold text-white">@a.Member?.FullName</span>
          </div>
          <div class="text-right flex flex-col items-end gap-1">
            <div class="text-xs text-gym-gray font-medium">@a.CheckInTime.ToString("hh:mm tt")</div>
            @if (a.CheckOutTime.HasValue)
            { <span class="badge-status badge-paid text-[10px]">Out</span> }
            else
            { <span class="badge-status badge-active text-[10px]">In</span> }
          </div>
        </div>
      }
      </div>
    }
  </div>
</div>
