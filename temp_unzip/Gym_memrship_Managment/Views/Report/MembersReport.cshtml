@model IEnumerable<Gym_memrship_Managment.Interfaces.MemberReportItem>
@{
    ViewData["Title"] = "Members Report";
    Layout = "_Layout";
    var fromDate = ViewBag.From as DateTime?;
    var toDate = ViewBag.To as DateTime?;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Members Report</h1>
        <p class="page-subtitle">
            Showing results @(fromDate.HasValue ? $"from {fromDate.Value:MMM dd, yyyy}" : "") 
            @(toDate.HasValue ? $"to {toDate.Value:MMM dd, yyyy}" : "")
        </p>
    </div>
    <div class="flex gap-2">
        <form method="get" action="/Report/Members">
            <input type="hidden" name="from" value="@fromDate?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="to" value="@toDate?.ToString("yyyy-MM-dd")" />
            <button type="submit" name="export" value="true" class="btn-outline-glass">
                <i class="bi bi-download"></i> Export CSV
            </button>
        </form>
        <a href="/Report" class="btn-outline-glass">Back to Reports</a>
    </div>
</div>

<div class="glass-card p-0">
    <div class="table-responsive">
        <table class="glass-table">
            <thead>
                <tr>
                    <th>Member ID</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Status</th>
                    <th>Join Date</th>
                    <th>Active Plan</th>
                    <th>Expiry Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MembershipNumber</td>
                        <td>
                            <div class="font-medium text-white">@item.FullName</div>
                            <div class="text-[12px] text-[#9994AA]">@item.Email</div>
                        </td>
                        <td>@item.Phone</td>
                        <td>
                            @if (item.Status == "Active")
                            {
                                <span class="badge-status badge-active">@item.Status</span>
                            }
                            else if (item.Status == "Expired")
                            {
                                <span class="badge-status badge-expired">@item.Status</span>
                            }
                            else
                            {
                                <span class="badge-status badge-inactive">@item.Status</span>
                            }
                        </td>
                        <td>@item.JoinDate.ToString("MMM dd, yyyy")</td>
                        <td>@(string.IsNullOrEmpty(item.ActivePlan) ? "-" : item.ActivePlan)</td>
                        <td>@(item.MembershipExpiry?.ToString("MMM dd, yyyy") ?? "-")</td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-[#9994AA] p-[30px]">
                            No data found for the selected criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
