@model RenewVm
@{
  ViewData["Title"] = "Renew Membership";
  Layout = "_Layout";
}

<div class="page-header">
  <div><h1 class="page-title">Renew Membership</h1></div>
  <a href="/Member/Details/@Model.Membership?.MemberId" class="btn-outline-glass"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (Model.Membership != null)
{
  var status = Model.Membership.ComputedStatus;
  var bc = status == MembershipStatus.Expired ? "badge-expired" : "badge-expiring";
  <div class="glass-card" style="margin-bottom:16px">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <div>
        <div style="font-weight:600;font-size:16px">@Model.Membership.Member?.FullName</div>
        <div style="font-size:12px;color:#9994AA">@Model.Membership.Plan?.PlanName — Expires @Model.Membership.EndDate.ToString("MMM dd, yyyy")</div>
      </div>
      <span class="badge-status @bc">@status</span>
    </div>
    @if (Model.LateFee > 0)
    {
      <div class="alert-glass alert-warning-glass" style="margin-top:12px">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <strong>Late Renewal Fee: $@Model.LateFee.ToString("N2")</strong> — This will be added automatically.
      </div>
    }
  </div>
}

<form asp-action="Renew" asp-controller="Membership" method="post" class="form-glass">
  @Html.AntiForgeryToken()
  <input asp-for="MembershipId" type="hidden" />
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div>
      <label class="form-label-dark">New Plan (optional)</label>
      <select asp-for="NewPlanId" class="form-control-dark" style="width:100%">
        <option value="">Keep current plan (@Model.Membership?.Plan?.PlanName)</option>
        @foreach (var p in Model.Plans)
        { <option value="@p.PlanId">@p.PlanName — $@p.Price.ToString("N2") / @p.DurationInDays days</option> }
      </select>
    </div>
    <div>
      <label class="form-label-dark">Discount ($)</label>
      <input asp-for="Discount" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0" />
    </div>
    <div>
      <label class="form-label-dark">Payment Method</label>
      <select asp-for="PaymentMethod" class="form-control-dark" style="width:100%">
        @foreach (var m in Enum.GetValues<PaymentMethod>()) { <option value="@m">@m</option> }
      </select>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end">
    <a href="/Member/Details/@Model.Membership?.MemberId" class="btn-outline-glass">Cancel</a>
    <button type="submit" class="btn-gradient-blue"><i class="bi bi-arrow-repeat"></i> Renew Membership</button>
  </div>
</form>
