@model Fine
@{
  ViewData["Title"] = "Create Fine";
  Layout = "_Layout";
}

<div class="page-header">
  <div><h1 class="page-title">Create Fine</h1></div>
  <a href="/Fine" class="btn-outline-glass"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (ViewBag.Member is MemberProfile member)
{
  <div class="glass-card" style="margin-bottom:16px;display:flex;align-items:center;gap:12px">
    <div class="avatar">@member.FullName.Substring(0,1)</div>
    <div>
      <div style="font-weight:600">@member.FullName</div>
      <div style="font-size:12px;color:#9994AA">@member.MembershipNumber • @member.Phone</div>
    </div>
  </div>
}

<form asp-action="Create" asp-controller="Fine" method="post" class="form-glass">
  @Html.AntiForgeryToken()
  <input asp-for="MemberId" type="hidden" />
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div style="grid-column:span 2">
      <label class="form-label-dark">Reason *</label>
      <textarea asp-for="Reason" class="form-control-dark" style="width:100%;height:80px;resize:none" placeholder="Reason for fine..." required></textarea>
    </div>
    <div>
      <label class="form-label-dark">Amount *</label>
      <input asp-for="Amount" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0.01" required />
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end">
    <a href="/Fine" class="btn-outline-glass">Cancel</a>
    <button type="submit" class="btn-gradient-pink"><i class="bi bi-exclamation-triangle"></i> Create Fine</button>
  </div>
</form>
