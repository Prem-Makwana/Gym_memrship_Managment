@model IEnumerable<Gym_memrship_Managment.Models.AuditLog>
@{
    ViewData["Title"] = "Audit Logs";
    Layout = "_Layout";
}

<div class="page-header">
  <div>
    <h1 class="page-title"><i class="bi bi-shield-lock" style="color:#8B5CF6"></i> Audit Logs</h1>
    <p class="page-subtitle">System activity tracking</p>
  </div>
</div>

<div class="glass-card" style="margin-bottom:16px;padding:14px 20px">
  <form method="get" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap">
    <div>
      <label class="form-label-dark" style="display:block">From</label>
      <input type="date" name="from" class="form-control-dark" value="@Context.Request.Query["from"]" />
    </div>
    <div>
      <label class="form-label-dark" style="display:block">To</label>
      <input type="date" name="to" class="form-control-dark" value="@Context.Request.Query["to"]" />
    </div>
    <div style="flex-grow:1">
      <label class="form-label-dark" style="display:block">Entity Name</label>
      <input type="text" name="entityName" class="form-control-dark" style="width:100%" placeholder="Entity Name..." value="@Context.Request.Query["entityName"]" />
    </div>
    <div>
      <button type="submit" class="btn-gradient-blue"><i class="bi bi-search"></i> Filter</button>
    </div>
  </form>
</div>

<div class="glass-card" style="padding:0;overflow:hidden">
  <div class="table-responsive">
    <table class="glass-table w-100">
      <thead>
        <tr>
          <th>Date</th>
          <th>User</th>
          <th>Action</th>
          <th>Entity</th>
          <th>IP Address</th>
          <th>Description</th>
        </tr>
      </thead>
      <tbody>
        @if (!Model.Any())
        {
          <tr><td colspan="6" style="text-align:center;padding:40px;color:#5c5875">No audit logs found</td></tr>
        }
        @foreach (var log in Model)
        {
          <tr>
            <td style="color:#9994AA;font-size:13px">@log.Timestamp.ToString("g")</td>
            <td><div style="font-weight:600;color:#F0F0F8">@(log.UserId ?? "System")</div></td>
            <td><span class="badge-status badge-active">@log.Action</span></td>
            <td><div style="color:#00D4FF">@log.EntityName</div><div style="font-size:11px;color:#9994AA">#@log.EntityId</div></td>
            <td style="font-family:monospace;font-size:12px;color:#9994AA">@log.IPAddress</td>
            <td style="color:#9994AA;font-size:13px">@log.Description</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>
