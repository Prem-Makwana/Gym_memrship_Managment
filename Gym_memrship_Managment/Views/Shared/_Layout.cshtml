<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] — FitZone Pro</title>

  <!-- Google Fonts: Oswald & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Flatpickr for custom calendar -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <style>
    /* Custom Neon/Dark Flatpickr Theme */
    .flatpickr-calendar {
      background: rgba(10,12,26,0.95) !important;
      border: 1px solid rgba(0,229,255,0.3) !important;
      box-shadow: 0 0 30px rgba(0,229,255,0.15) !important;
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);
      border-radius: 12px !important;
      color: #fff !important;
    }
    .flatpickr-months .flatpickr-month {
      background: transparent !important;
      color: #fff !important;
    }
    .flatpickr-current-month .flatpickr-monthDropdown-months {
      background: #0a0c1a !important;
      color: #fff !important;
    }
    .flatpickr-current-month .numInputWrapper span.arrowUp:after {
      border-bottom-color: #00E5FF !important;
    }
    .flatpickr-current-month .numInputWrapper span.arrowDown:after {
      border-top-color: #00E5FF !important;
    }
    .flatpickr-day {
      color: #aaa !important;
      border-radius: 8px !important;
    }
    .flatpickr-day:hover, .flatpickr-day:focus {
      background: rgba(0,229,255,0.15) !important;
      border-color: #00E5FF !important;
      color: #fff !important;
    }
    .flatpickr-day.selected, .flatpickr-day.startRange, .flatpickr-day.endRange, .flatpickr-day.selected.inRange, .flatpickr-day.startRange.inRange, .flatpickr-day.endRange.inRange, .flatpickr-day.selected:focus, .flatpickr-day.startRange:focus, .flatpickr-day.endRange:focus, .flatpickr-day.selected:hover, .flatpickr-day.startRange:hover, .flatpickr-day.endRange:hover, .flatpickr-day.selected.prevMonthDay, .flatpickr-day.startRange.prevMonthDay, .flatpickr-day.endRange.prevMonthDay, .flatpickr-day.selected.nextMonthDay, .flatpickr-day.startRange.nextMonthDay, .flatpickr-day.endRange.nextMonthDay {
      background: #00E5FF !important;
      color: #000 !important;
      border-color: #00E5FF !important;
      font-weight: bold;
      box-shadow: 0 0 15px rgba(0,229,255,0.6) !important;
    }
    .flatpickr-day.today {
      border-color: #8B5CF6 !important;
      color: #8B5CF6 !important;
    }
    .flatpickr-day.today:hover, .flatpickr-day.today:focus {
      border-color: #8B5CF6 !important;
      background: #8B5CF6 !important;
      color: #fff !important;
    }
    .flatpickr-weekday {
      color: #00E5FF !important;
      font-weight: 600 !important;
    }
    .flatpickr-months .flatpickr-prev-month, .flatpickr-months .flatpickr-next-month {
      color: #00E5FF !important;
      fill: #00E5FF !important;
    }
    .flatpickr-months .flatpickr-prev-month:hover svg, .flatpickr-months .flatpickr-next-month:hover svg {
      fill: #8B5CF6 !important;
    }
  </style>
  
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
  
  <!-- Anime.js v4 & Three.js (ES Module Import Map) -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/+esm",
        "animejs": "https://cdn.jsdelivr.net/npm/animejs@4.5.0/+esm",
        "animejs/adapters/three": "https://cdn.jsdelivr.net/npm/animejs@4.5.0/dist/modules/adapters/three/index.js/+esm"
      }
    }
  </script>
  
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="~/css/gym.css" asp-append-version="true" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            oswald: ['Oswald', 'sans-serif'],
          },
          colors: {
            gym: {
              dark: '#0A0A0A',
              card: 'rgba(20, 20, 20, 0.6)',
              blue: '#00E5FF',
              orange: '#FF4D00',
              green: '#39FF14',
              red: '#FF003C',
              gray: '#9CA3AF'
            }
          }
        }
      }
    }
  </script>


</head>
<body class="bg-gym-dark text-white font-sans antialiased overflow-x-hidden min-h-screen">
  
  <!-- Ambient background glows -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden">
    <div class="ambient-glow-1 absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-gym-blue opacity-[0.15] blur-[100px]"></div>
    <div class="ambient-glow-2 absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-gym-orange opacity-[0.12] blur-[100px]"></div>
  </div>

  <!-- Hidden flash message carriers -->
  @if (TempData["Success"] != null)
  {
    <div id="server-success" data-msg='@TempData["Success"]' style="display:none"></div>
  }
  @if (TempData["Error"] != null)
  {
    <div id="server-error" data-msg='@TempData["Error"]' style="display:none"></div>
  }

  @if (User.Identity?.IsAuthenticated == true)
  {
    <!-- Sidebar -->
    <nav class="sidebar fixed top-0 left-0 h-screen w-[280px] z-50 flex flex-col bg-black/40 backdrop-blur-xl border-r border-white/10 shadow-[4px_0_24px_rgba(0,229,255,0.05)] transition-transform duration-300">
      
      <div class="p-6 border-b border-white/10 flex items-center gap-3 shrink-0">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-gym-blue to-blue-700 flex items-center justify-center shadow-[0_0_15px_rgba(0,229,255,0.5)]">
          <i class="bi bi-lightning-charge-fill text-xl text-white"></i>
        </div>
        <div>
          <div class="text-xl font-oswald font-bold bg-clip-text text-transparent bg-gradient-to-r from-gym-blue to-gym-green uppercase tracking-wide">
            FitZone Pro
          </div>
          <div class="text-[10px] text-gym-gray uppercase tracking-[0.2em]">God Level</div>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 space-y-1 custom-scrollbar">
        <!-- Dashboard -->
        <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-2 px-3">Main</div>
        <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Dashboard") ? "active-nav" : "text-gray-400 hover:text-white")"
           href="/Dashboard">
          <i class="bi bi-grid-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
          <span class="font-medium">Dashboard</span>
        </a>

        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
        {
          <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">Members</div>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Member") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Member">
            <i class="bi bi-people-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Members</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Membership") && !Context.Request.Path.StartsWithSegments("/MembershipPlan") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Membership">
            <i class="bi bi-card-checklist text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Memberships</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/MembershipPlan") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/MembershipPlan">
            <i class="bi bi-tag-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Plans</span>
          </a>

          <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">Operations</div>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Attendance") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Attendance/CheckIn">
            <i class="bi bi-qr-code-scan text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Check-In</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Payment") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Payment">
            <i class="bi bi-cash-stack text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Payments</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Fine") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Fine">
            <i class="bi bi-exclamation-triangle-fill text-lg group-hover:text-gym-orange transition-colors"></i> 
            <span class="font-medium">Fines</span>
          </a>

          <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">Setup</div>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Batch") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Batch">
            <i class="bi bi-calendar2-week-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Batches</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Trainer") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Trainer">
            <i class="bi bi-person-badge-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Trainers</span>
          </a>
        }

        @if (User.IsInRole("Admin"))
        {
          <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">Admin</div>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Report") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Report">
            <i class="bi bi-bar-chart-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Reports</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/AuditLog") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/AuditLog">
            <i class="bi bi-shield-check text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Audit Log</span>
          </a>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Settings") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Settings">
            <i class="bi bi-gear-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">Settings</span>
          </a>
        }

        @if (User.IsInRole("Member"))
        {
          <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">My Account</div>
          <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Member/MyProfile") ? "active-nav" : "text-gray-400 hover:text-white")"
             href="/Member/MyProfile">
            <i class="bi bi-person-circle text-lg group-hover:text-gym-blue transition-colors"></i> 
            <span class="font-medium">My Profile</span>
          </a>
        }

        <div class="text-[10px] font-bold text-gym-gray uppercase tracking-[0.15em] mb-2 mt-6 px-3">Account</div>
        <a class="nav-item group flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 hover:bg-white/5 hover:-translate-y-1 @(Context.Request.Path.StartsWithSegments("/Notification") ? "active-nav" : "text-gray-400 hover:text-white")"
           href="/Notification">
          <i class="bi bi-bell-fill text-lg group-hover:text-gym-blue transition-colors"></i> 
          <span class="font-medium">Notifications</span>
        </a>
      </div>

      <!-- User Profile -->
      <div class="p-4 border-t border-white/10 bg-black/20 shrink-0">
        <div class="flex items-center gap-3 px-2">
          <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-gym-blue to-purple-600 flex items-center justify-center font-bold shadow-[0_0_10px_rgba(0,229,255,0.3)] shrink-0">
            @User.Identity!.Name!.Substring(0,1).ToUpper()
          </div>
          <div class="min-w-0">
            <div class="text-sm font-semibold text-white truncate">
              @User.Identity.Name
            </div>
            <div class="text-xs text-gym-gray">
              @(User.IsInRole("Admin") ? "Administrator" : User.IsInRole("Staff") ? "Staff" : "Member")
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Top Navbar -->
    <header class="top-navbar fixed top-0 right-0 h-[72px] z-40 bg-black/30 backdrop-blur-2xl border-b border-white/10 shadow-[0_4px_30px_rgba(0,0,0,0.5)] flex items-center justify-between px-8 transition-all duration-300 left-0 md:left-[280px]">
      <div class="flex items-center gap-4">
        <button onclick="toggleSidebar()" class="md:hidden text-gym-gray hover:text-white transition-colors">
          <i class="bi bi-list text-2xl"></i>
        </button>
        <span class="text-xl font-oswald font-medium tracking-wide">@(ViewData["Title"] ?? "Dashboard")</span>
      </div>
      
      <div class="flex items-center gap-5">
        <!-- Notification Bell -->
        <a href="/Notification" class="relative text-gray-400 hover:text-white transition-colors group">
          <div class="absolute inset-0 bg-gym-blue/20 rounded-full blur-md scale-0 group-hover:scale-150 transition-transform duration-300"></div>
          <i class="bi bi-bell text-xl relative z-10"></i>
          <span class="absolute -top-1 -right-1 w-4 h-4 bg-gym-red rounded-full text-[9px] font-bold flex items-center justify-center text-white shadow-[0_0_10px_rgba(255,0,60,0.5)]" id="notification-count" style="display:none">0</span>
        </a>
        
                  <!-- Logout -->
        <form method="post" action="/Account/Logout" class="m-0">
          @Html.AntiForgeryToken()
          <button type="submit" class="group relative px-4 py-2 rounded-lg font-medium text-sm overflow-hidden border border-white/10 hover:border-gym-red/50 transition-colors">
            <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-gym-red/20 to-transparent -translate-x-full group-hover:translate-x-0 transition-transform duration-300"></div>
            <span class="relative z-10 flex items-center gap-2 text-gray-300 group-hover:text-white">
              <i class="bi bi-box-arrow-right text-gym-red"></i> Logout
            </span>
          </button>
        </form>
      </div>
    </header>

    <!-- Main Content -->
    <main class="main-content relative z-10 pt-[100px] pb-10 px-6 md:px-10 ml-0 md:ml-[280px] min-h-screen transition-all duration-300">
      @RenderBody()
    </main>
  }
  else
  {
    <!-- Non-authenticated: full page -->
    <main class="relative z-10 min-h-screen">
      @RenderBody()
    </main>
  }

  <!-- Anti-forgery token for AJAX -->
  @Html.AntiForgeryToken()

  <!-- Global Loader -->
  <div id="global-loader" class="fixed inset-0 bg-black/60 backdrop-blur-md z-[9999] hidden flex items-center justify-center transition-opacity duration-300 opacity-0">
    <div class="relative w-24 h-24 flex items-center justify-center">
      <div class="absolute inset-0 border-4 border-gym-blue/20 rounded-full"></div>
      <div class="absolute inset-0 border-4 border-gym-blue rounded-full border-t-transparent animate-spin"></div>
      <div class="absolute inset-0 border-4 border-gym-orange rounded-full border-b-transparent animate-[spin_1.5s_linear_infinite_reverse] scale-75"></div>
      <i class="bi bi-lightning-charge-fill text-2xl text-gym-blue animate-pulse"></i>
    </div>
  </div>

  <!-- Custom JS -->
  <script src="~/js/site.js" asp-append-version="true"></script>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>

  @await RenderSectionAsync("Scripts", required: false)
  
  <script>
    // 1. Three.js Background
    const canvas = document.createElement('canvas');
    canvas.style.position = 'fixed';
    canvas.style.top = '0';
    canvas.style.left = '0';
    canvas.style.width = '100vw';
    canvas.style.height = '100vh';
    canvas.style.zIndex = '-1'; 
    canvas.style.pointerEvents = 'none';
    document.body.prepend(canvas);

    const renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 5;

    const geometry = new THREE.IcosahedronGeometry(2.5, 1);
    const material = new THREE.MeshBasicMaterial({ 
        color: 0x00E5FF, 
        wireframe: true, 
        transparent: true, 
        opacity: 0.08
    });
    const sphere = new THREE.Mesh(geometry, material);
    scene.add(sphere);

    function render() {
        requestAnimationFrame(render);
        renderer.render(scene, camera);
    }
    render();

    window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // Animate Three.js properties natively using Anime v3
    anime({
        targets: sphere.rotation,
        x: Math.PI * 2,
        y: Math.PI * 2,
        duration: 40000,
        easing: 'linear',
        loop: true
    });

    anime({
        targets: sphere.scale,
        x: [1, 1.1, 1],
        y: [1, 1.1, 1],
        z: [1, 1.1, 1],
        duration: 8000,
        easing: 'easeInOutSine',
        loop: true
    });

    // 2. Anime.js v3 Advanced Timeline (Page Load)
    const tl = anime.timeline({
        easing: 'easeOutElastic(1, .6)',
        duration: 800
    });

    const sidebarItems = document.querySelectorAll('.sidebar .nav-item');
    if (sidebarItems.length > 0) {
        tl.add({
            targets: sidebarItems,
            translateX: [-50, 0],
            opacity: [0, 1],
            delay: anime.stagger(50)
        }, 0);
    }

    const navbar = document.querySelector('.top-navbar');
    if (navbar) {
        tl.add({
            targets: navbar,
            translateY: [-70, 0],
            opacity: [0, 1]
        }, 100);
    }

    const statCards = document.querySelectorAll('.stat-card, .glass-card:not(.no-anim)');
    if (statCards.length > 0) {
        tl.add({
            targets: statCards,
            translateY: [30, 0],
            opacity: [0, 1],
            delay: anime.stagger(100),
            easing: 'easeOutCubic'
        }, 300);
    }

    // 3. Anime.js Scroll animations (Simulated for v3)
    const scrollElements = document.querySelectorAll('.glass-table tbody tr');
    if (scrollElements.length > 0) {
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    anime({
                        targets: entry.target,
                        translateY: [30, 0],
                        opacity: [0, 1],
                        duration: 800,
                        easing: 'easeOutCubic'
                    });
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.1 });
        scrollElements.forEach(el => observer.observe(el));
    }

    // 4. Interactive Clicks
    const interactiveElements = document.querySelectorAll('.btn-gradient-blue, .btn-outline-glass, .stat-card, .nav-item');
    interactiveElements.forEach(el => {
      let currentAnim = null;
      el.addEventListener('mousedown', () => {
        if (currentAnim) currentAnim.pause();
        currentAnim = anime({ targets: el, scale: 0.95, duration: 300, easing: 'easeOutQuart' });
      });
      
      const release = () => {
        if (currentAnim) currentAnim.pause();
        currentAnim = anime({ targets: el, scale: 1, duration: 600, easing: 'easeOutElastic(1, .5)' });
      };
      
      el.addEventListener('mouseup', release);
      el.addEventListener('mouseleave', release);
    });
  </script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
  <script>
    function runPageAnimations() {
      if (typeof anime === 'undefined') return;
      document.querySelectorAll('.anime-count-up').forEach(function(el) {
        var val = parseFloat(el.getAttribute('data-value') || 0);
        var prefix = el.getAttribute('data-prefix') || '';
        el.innerHTML = prefix + '0';
        if (val === 0) return;
        anime({
          targets: el, innerHTML: [0, val], easing: 'easeOutExpo', round: 1, duration: 1800,
          update: function(anim) { el.innerHTML = prefix + parseInt(anim.animations[0].currentValue).toLocaleString('en-IN'); }
        });
      });
    }
    document.addEventListener('DOMContentLoaded', runPageAnimations);
  </script>
  <!-- Flatpickr JS -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function() {
      // Initialize Flatpickr on all inputs of type "date"
      flatpickr('input[type="date"]', {
        altInput: true,
        altFormat: "F j, Y",
        dateFormat: "Y-m-d",
        disableMobile: "true" // Ensures the beautiful custom calendar is used on mobile too
      });
    });
  </script>
</body>
</html>













