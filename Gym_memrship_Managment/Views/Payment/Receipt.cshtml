@model ReceiptVm
@{
  ViewData["Title"] = "Receipt #" + Model.Payment.ReceiptNumber;
  Layout = "_Layout";
}

<div style="max-width:600px;margin:0 auto">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px" class="no-print">
    <a href="/Payment" class="btn-outline-glass"><i class="bi bi-arrow-left"></i> Back</a>
    <button onclick="window.print()" class="btn-gradient-blue"><i class="bi bi-printer"></i> Print Receipt</button>
  </div>

  <div class="glass-card" style="padding:36px">
    <!-- Header -->
    <div style="text-align:center;margin-bottom:28px;padding-bottom:24px;border-bottom:2px dashed rgba(255,255,255,0.1)">
      <div style="font-size:28px;margin-bottom:4px">⚡</div>
      <h2 style="margin:0;font-size:20px;background:linear-gradient(135deg,#00D4FF,#8B5CF6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">@Model.GymName</h2>
      <p style="margin:4px 0;color:#9994AA;font-size:12px">@Model.GymAddress</p>
      <p style="margin:0;color:#9994AA;font-size:12px">@Model.GymPhone</p>
    </div>

    <!-- Receipt Title -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
      <div>
        <div style="font-size:20px;font-weight:700;color:#F0F0F8">RECEIPT</div>
        <div style="font-size:12px;color:#5c5875;font-family:monospace">@Model.Payment.ReceiptNumber</div>
      </div>
      <div style="text-align:right">
        <div style="font-size:13px;color:#9994AA">Date</div>
        <div style="font-weight:600">@Model.Payment.PaymentDate.ToString("MMM dd, yyyy")</div>
      </div>
    </div>

    <!-- Member Info -->
    <div style="background:rgba(255,255,255,0.04);border-radius:8px;padding:16px;margin-bottom:20px">
      <div style="font-size:12px;color:#5c5875;margin-bottom:4px">BILLED TO</div>
      <div style="font-weight:600;font-size:15px">@Model.Payment.Member?.FullName</div>
      <div style="font-size:12px;color:#9994AA">ID: @Model.Payment.Member?.MembershipNumber</div>
      <div style="font-size:12px;color:#9994AA">@Model.Payment.Member?.Phone</div>
    </div>

    <!-- Payment Details -->
    <table style="width:100%;margin-bottom:20px">
      <tr>
        <td style="padding:8px 0;color:#9994AA;font-size:13px">Payment Type</td>
        <td style="padding:8px 0;text-align:right;font-weight:500">@Model.Payment.PaymentType</td>
      </tr>
      <tr>
        <td style="padding:8px 0;color:#9994AA;font-size:13px">Payment Method</td>
        <td style="padding:8px 0;text-align:right;font-weight:500">@Model.Payment.PaymentMethod</td>
      </tr>
      @if (Model.Payment.Membership?.Plan != null)
      {
        <tr>
          <td style="padding:8px 0;color:#9994AA;font-size:13px">Plan</td>
          <td style="padding:8px 0;text-align:right;font-weight:500">@Model.Payment.Membership.Plan.PlanName</td>
        </tr>
      }
      @if (!string.IsNullOrEmpty(Model.Payment.TransactionReference))
      {
        <tr>
          <td style="padding:8px 0;color:#9994AA;font-size:13px">Reference</td>
          <td style="padding:8px 0;text-align:right;font-size:12px;color:#9994AA">@Model.Payment.TransactionReference</td>
        </tr>
      }
      @if (!string.IsNullOrEmpty(Model.Payment.Notes))
      {
        <tr>
          <td style="padding:8px 0;color:#9994AA;font-size:13px">Notes</td>
          <td style="padding:8px 0;text-align:right;font-size:12px;color:#9994AA">@Model.Payment.Notes</td>
        </tr>
      }
    </table>

    <!-- Amount -->
    <div style="border-top:1px solid rgba(255,255,255,0.1);padding-top:20px;margin-bottom:24px">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <span style="font-size:16px;font-weight:600">TOTAL AMOUNT</span>
        <span style="font-size:28px;font-weight:700;color:#00FF88">₹@Model.Payment.Amount.ToString("N2")</span>
      </div>
    </div>

    <!-- Footer -->
    <div style="text-align:center;color:#5c5875;font-size:11px;border-top:1px dashed rgba(255,255,255,0.08);padding-top:16px">
      <p style="margin:0">Thank you for choosing @Model.GymName!</p>
      <p style="margin:4px 0">Keep this receipt for your records.</p>
      @if (!string.IsNullOrEmpty(Model.Payment.ReceivedBy))
      { <p style="margin:0">Received by: @Model.Payment.ReceivedBy</p> }
    </div>
  </div>
</div>
