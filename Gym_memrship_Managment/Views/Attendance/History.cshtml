@model List<Attendance>
@{
  ViewData["Title"] = "Attendance History";
  Layout = "_Layout";
}

<div class="page-header">
  <div><h1 class="page-title">Attendance History</h1></div>
  <a href="/Attendance/CheckIn" class="btn-gradient-blue"><i class="bi bi-qr-code-scan"></i> Check-In</a>
</div>

<!-- Filters -->
<div class="glass-card" style="margin-bottom:16px;padding:14px 20px">
  <form method="get" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap">
    <div>
      <label class="form-label-dark" style="display:block">From</label>
      <input type="date" name="from" value="@ViewBag.From?.ToString("yyyy-MM-dd")" class="form-control-dark" />
    </div>
    <div>
      <label class="form-label-dark" style="display:block">To</label>
      <input type="date" name="to" value="@ViewBag.To?.ToString("yyyy-MM-dd")" class="form-control-dark" />
    </div>
    <div>
      <label class="form-label-dark" style="display:block">Batch</label>
      <select name="batchId" class="form-control-dark">
        <option value="">All Batches</option>
        @foreach (var b in (List<Batch>)ViewBag.Batches)
        { <option value="@b.BatchId" selected="@(ViewBag.BatchId?.ToString() == b.BatchId.ToString() ? "selected" : null)">@b.BatchName</option> }
      </select>
    </div>
    <div style="align-self:flex-end">
      <button type="submit" class="btn-gradient-blue">Filter</button>
    </div>
  </form>
</div>

<div class="glass-card" style="padding:0;overflow:hidden">
  <table class="glass-table">
    <thead>
      <tr><th>Member</th><th>Date</th><th>Check In</th><th>Check Out</th><th>Duration</th><th>Batch</th><th>Status</th></tr>
    </thead>
    <tbody>
      @if (!Model.Any())
      {
        <tr><td colspan="7" style="text-align:center;padding:40px;color:#5c5875">No attendance records found</td></tr>
      }
      @foreach (var a in Model)
      {
        <tr>
          <td>
            <div style="font-weight:500">@a.Member?.FullName</div>
            <div style="font-size:11px;color:#5c5875">@a.Member?.MembershipNumber</div>
          </td>
          <td style="color:#9994AA">@a.Date.ToString("MMM dd, yyyy")</td>
          <td>@a.CheckInTime.ToString("hh:mm tt")</td>
          <td style="color:#9994AA">@(a.CheckOutTime?.ToString("hh:mm tt") ?? "-")</td>
          <td style="color:#9994AA">@(a.DurationMinutes.HasValue ? $"{a.DurationMinutes} min" : "-")</td>
          <td style="font-size:12px;color:#5c5875">@(a.Batch?.BatchName ?? "-")</td>
          <td>
            @{
              var bc = a.Status == AttendanceStatus.Present ? "badge-active"
                  : a.Status == AttendanceStatus.CheckedOut ? "badge-paid"
                  : "badge-inactive";
            }
            <span class="badge-status @bc">@a.Status</span>
          </td>
        </tr>
      }
    </tbody>
  </table>
</div>

<!-- Pagination -->
@if (ViewBag.TotalPages > 1)
{
  <div style="display:flex;justify-content:center;margin-top:16px">
    <div class="pagination-glass">
      @for (var i = 1; i <= (int)ViewBag.TotalPages; i++)
      {
        <a href="?from=@ViewBag.From?.ToString("yyyy-MM-dd")&to=@ViewBag.To?.ToString("yyyy-MM-dd")&batchId=@ViewBag.BatchId&page=@i"
           class="page-btn @(i == (int)ViewBag.CurrentPage ? "active" : "")">@i</a>
      }
    </div>
  </div>
}
