@model MembershipPlan
@{
  ViewData["Title"] = "Create Membership Plan";
  Layout = "_Layout";
}

<div class="page-header">
  <div><h1 class="page-title">Create Membership Plan</h1></div>
  <a href="/MembershipPlan" class="btn-outline-glass"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<form asp-action="Create" asp-controller="MembershipPlan" method="post" class="form-glass">
  @Html.AntiForgeryToken()
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div style="grid-column:span 2">
      <label class="form-label-dark">Plan Name *</label>
      <input asp-for="PlanName" class="form-control-dark" style="width:100%" placeholder="e.g., Premium Monthly" required />
    </div>
    <div style="grid-column:span 2">
      <label class="form-label-dark">Description</label>
      <textarea asp-for="Description" class="form-control-dark" style="width:100%;height:80px;resize:none" placeholder="What's included in this plan..."></textarea>
    </div>
    <div>
      <label class="form-label-dark">Duration (Days) *</label>
      <input asp-for="DurationInDays" type="number" class="form-control-dark" style="width:100%" min="1" max="3650" required />
    </div>
    <div>
      <label class="form-label-dark">Price *</label>
      <input asp-for="Price" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0" required />
    </div>
    <div>
      <label class="form-label-dark">Registration Fee</label>
      <input asp-for="RegistrationFee" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0" />
    </div>
    <div>
      <label class="form-label-dark">Renewal Fee</label>
      <input asp-for="RenewalFee" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0" />
    </div>
    <div>
      <label class="form-label-dark">Late Fee Per Day</label>
      <input asp-for="LateFeePerDay" type="number" step="0.01" class="form-control-dark" style="width:100%" min="0" />
    </div>
    <div>
      <label class="form-label-dark">Grace Period (Days)</label>
      <input asp-for="GracePeriodDays" type="number" class="form-control-dark" style="width:100%" min="0" />
    </div>
    <div>
      <label style="display:flex;align-items:center;gap:8px;cursor:pointer;color:#9994AA">
        <input asp-for="IsActive" type="checkbox" style="width:16px;height:16px" />
        Active (available for enrollment)
      </label>
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end">
    <a href="/MembershipPlan" class="btn-outline-glass">Cancel</a>
    <button type="submit" class="btn-gradient-blue"><i class="bi bi-save"></i> Create Plan</button>
  </div>
</form>
