@model Dictionary<string, string>
@{
    ViewData["Title"] = "System Settings";
    Layout = "_Layout";
}

<div class="page-header">
  <div>
    <h1 class="page-title"><i class="bi bi-gear" style="color:#8B5CF6"></i> System Settings</h1>
    <p class="page-subtitle">Configure global application behavior</p>
  </div>
</div>

<div class="glass-card" style="padding:24px; max-width:800px">
    <form asp-action="Update" method="post">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px">
            @foreach (var kvp in Model)
            {
                <div>
                    <label class="form-label-dark" style="display:block; margin-bottom:8px">@kvp.Key</label>
                    <input type="text" name="settings[@kvp.Key]" value="@kvp.Value" class="form-control-dark" style="width:100%" />
                </div>
            }
        </div>
        
        <div style="border-top:1px solid rgba(255,255,255,0.05); padding-top:20px">
            <button type="submit" class="btn-gradient-blue"><i class="bi bi-save"></i> Save Changes</button>
        </div>
    </form>
</div>
