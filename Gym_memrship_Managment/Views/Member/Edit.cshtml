@model MemberEditVm
@{
  ViewData["Title"] = "Edit Member";
  Layout = "_Layout";
}

<div class="page-header">
  <div><h1 class="page-title">Edit Member</h1></div>
  <a href="/Member/Details/@Model.MemberId" class="btn-outline-glass"><i class="bi bi-arrow-left"></i> Back</a>
</div>

<form asp-action="Edit" asp-controller="Member" method="post" class="form-glass">
  @Html.AntiForgeryToken()
  <input asp-for="MemberId" type="hidden" />
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <div>
      <label class="form-label-dark">Full Name *</label>
      <input asp-for="FullName" class="form-control-dark" style="width:100%" required maxlength="100" />
    </div>
    <div>
      <label class="form-label-dark">Gender</label>
      <select asp-for="Gender" class="form-control-dark" style="width:100%">
        @foreach (var g in Enum.GetValues<Gender>()) { <option value="@g">@g</option> }
      </select>
    </div>
    <div>
      <label class="form-label-dark">Date of Birth</label>
      <input asp-for="DateOfBirth" type="date" class="form-control-dark" style="width:100%" />
    </div>
    <div>
      <label class="form-label-dark">Phone *</label>
      <input asp-for="Phone" class="form-control-dark" style="width:100%" required />
    </div>
    <div>
      <label class="form-label-dark">Email *</label>
      <input asp-for="Email" type="email" class="form-control-dark" style="width:100%" required />
    </div>
    <div>
      <label class="form-label-dark">Status</label>
      <select asp-for="Status" class="form-control-dark" style="width:100%">
        @foreach (var s in Enum.GetValues<MemberStatus>()) { <option value="@s">@s</option> }
      </select>
    </div>
    <div>
      <label class="form-label-dark">Address</label>
      <input asp-for="Address" class="form-control-dark" style="width:100%" />
    </div>
    <div>
      <label class="form-label-dark">Emergency Contact</label>
      <input asp-for="EmergencyContactName" class="form-control-dark" style="width:100%" />
    </div>
    <div>
      <label class="form-label-dark">Emergency Phone</label>
      <input asp-for="EmergencyContactPhone" class="form-control-dark" style="width:100%" />
    </div>
  </div>
  <div style="display:flex;gap:10px;margin-top:24px;justify-content:flex-end">
    <a href="/Member/Details/@Model.MemberId" class="btn-outline-glass">Cancel</a>
    <button type="submit" class="btn-gradient-blue"><i class="bi bi-save"></i> Save Changes</button>
  </div>
</form>
